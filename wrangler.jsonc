
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-worker",
  "main": "index.js",
  "compatibility_date": "2026-11-18",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-report-db",
      "database_id": "YOUR_DATABASE_ID"
    }
  ],

  "observability": {
    "enabled": true
  }
}

